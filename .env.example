MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ifa
MYSQL_USER=ifa_user
MYSQL_PASSWORD=change-me

POP3_HOST=pop3.example.com
POP3_PORT=995
POP3_USER=change-me
POP3_PASSWORD=change-me
POP3_USE_SSL=true
POP3_TIMEOUT_SECONDS=30

TARGET_SUBJECT_PREFIX=[분석 대기] [Defect 형태/성분 분석의뢰]
DUPLICATE_WINDOW_HOURS=72
MAX_RETRY_COUNT=3

# RETRY와 신규 메일을 합쳐 한 번의 실행에서 분석할 최대 건수
MAX_ANALYSIS_PER_RUN=3
# 분석 API 호출 사이 대기 시간(초)
ANALYSIS_INTERVAL_SECONDS=3

# 비정상 종료 후 PROCESSING 상태를 RETRY로 복구할 기준 시간(분)
STALE_PROCESSING_MINUTES=15
# MySQL advisory lock 이름과 대기 시간(초)
PIPELINE_LOCK_NAME=request_pipeline_scheduler
PIPELINE_LOCK_WAIT_SECONDS=0

REPORT_SEARCH_BASE_URL=https://ae-llm-agent--fa-report-search-prod.cdep1.ss.net
REPORT_SEARCH_SERVICE_KEY=dev-only-change-this-key
WEB_API_CONNECT_TIMEOUT=10
WEB_API_READ_TIMEOUT=180

# 현재 개발 환경 기본값: false
# 운영에서는 true와 사내 CA PEM 경로를 명시하십시오.
REPORT_SEARCH_VERIFY_SSL=false
REPORT_SEARCH_CA_BUNDLE=

MAIL_SEND_ENABLED=false
MAIL_RECIPIENT_MODE=TEST
MAIL_TEST_RECIPIENT=your-account@example.com
MAIL_ALLOW_ORIGINAL_RECIPIENT=false
