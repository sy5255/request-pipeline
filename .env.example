MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ifa
MYSQL_USER=ifa_user
MYSQL_PASSWORD=change-me

# 중앙 ingest_pop3.py가 POP3 수집과 DB 라우팅을 담당합니다.
POP3_COLLECTION_ENABLED=false
POP3_HOST=pop3.example.com
POP3_PORT=995
POP3_USER=change-me
POP3_PASSWORD=change-me
POP3_USE_SSL=true
POP3_TIMEOUT_SECONDS=30

TARGET_SUBJECT_PREFIX=[분석 대기] [Defect 형태/성분 분석의뢰]
DUPLICATE_WINDOW_HOURS=72
MAX_RETRY_COUNT=3

# run_pipeline.py 스케줄러 실행 주기: 55분 처리 후 3분 대기, 총 58분 후 종료
PIPELINE_ACTIVE_WINDOW_SECONDS=3300
PIPELINE_REST_WINDOW_SECONDS=180
PIPELINE_POLL_SECONDS=60

MAX_ANALYSIS_PER_RUN=3
ANALYSIS_INTERVAL_SECONDS=3
STALE_PROCESSING_MINUTES=15
PIPELINE_LOCK_NAME=request_pipeline_scheduler
PIPELINE_LOCK_WAIT_SECONDS=0

REPORT_SEARCH_BASE_URL=https://ae-llm-agent--fa-report-search-prod.cdep1.ss.net
REPORT_SEARCH_SERVICE_KEY=dev-only-change-this-key
WEB_API_CONNECT_TIMEOUT=10
WEB_API_READ_TIMEOUT=180
REPORT_SEARCH_VERIFY_SSL=false
REPORT_SEARCH_CA_BUNDLE=

# false이면 분석은 계속 수행하지만 자동 메일링만 즉시 중단됩니다.
MAIL_SEND_ENABLED=false

# TEST: 모든 메일을 MAIL_TEST_RECIPIENT 한 곳으로 강제 우회
# ORIGINAL: 원본 요청자에게 발송. MAIL_ALLOW_ORIGINAL_RECIPIENT=true도 필요
MAIL_RECIPIENT_MODE=TEST
MAIL_TEST_RECIPIENT=your-account@example.com
MAIL_ALLOW_ORIGINAL_RECIPIENT=false
MAIL_SEND_BATCH_SIZE=1
MAIL_SEND_STALE_MINUTES=15
MAIL_SUBJECT_PREFIX=[IFA Curator]

KNOX_MAIL_API_URL=https://openapi.stage.example.com/mail/api/v2.0/mails/send
KNOX_MAIL_USER_ID=agent
KNOX_MAIL_AUTH_TOKEN=change-me
KNOX_MAIL_SYSTEM_ID=change-me
KNOX_MAIL_SENDER_EMAIL=agent@example.com
KNOX_MAIL_DOC_SECU_TYPE=PERSONAL
# HTML을 사용하면 본문의 연관 링크가 클릭 가능한 앵커로 발송됩니다.
KNOX_MAIL_CONTENT_TYPE=HTML
KNOX_MAIL_CONNECT_TIMEOUT=10
KNOX_MAIL_READ_TIMEOUT=30
KNOX_MAIL_VERIFY_SSL=true
KNOX_MAIL_CA_BUNDLE=
